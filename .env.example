# Required: Your Anthropic API key
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Override the default AI models
# Default model for most responses (fast, smart)
ANTHROPIC_MODEL=claude-sonnet-5-20251001
# Model for deep analysis tasks (more powerful, slower)
ANTHROPIC_ANALYSIS_MODEL=claude-opus-5-5-20251101

# Optional: Phase 2 integrations (not required for V1)
# HUBSPOT_API_KEY=
# AIRTABLE_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MAKE_WEBHOOK_URL=
