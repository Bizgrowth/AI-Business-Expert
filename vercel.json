{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/chat/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/upload/route.ts": {
      "maxDuration": 60
    }
  },
  "env": {
    "ANTHROPIC_API_KEY": "@anthropic_api_key"
  }
}
